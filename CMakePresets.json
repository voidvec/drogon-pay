{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "conan-base",
      "hidden": true,
      "description": "Shared settings for all Conan-driven presets. Run `conan install . --output-folder=build/<preset-name> -s build_type=<Release|Debug> -s compiler.cppstd=17 --build=missing` for the matching preset name BEFORE running `cmake --preset <preset-name>`, so that build/<preset-name>/conan_toolchain.cmake exists.",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "conan-base",
      "displayName": "Linux Release (Conan)",
      "description": "conan install . --output-folder=build/linux-release -s build_type=Release -s compiler.cppstd=17 --build=missing",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-release/build/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-coverage",
      "inherits": "conan-base",
      "displayName": "Linux Debug + gcov (Conan)",
      "description": "conan install . --output-folder=build/linux-coverage -s build_type=Debug -s compiler.cppstd=17 --build=missing",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DROGON_PAY_COVERAGE": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-coverage/build/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "conan-base",
      "displayName": "Linux Debug (Conan)",
      "description": "conan install . --output-folder=build/linux-debug -s build_type=Debug -s compiler.cppstd=17 --build=missing",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/linux-debug/build/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "conan-base",
      "displayName": "Windows MSVC (Conan)",
      "description": "conan install . --output-folder=build/windows-msvc -s build_type=Release -s compiler.cppstd=17 --build=missing",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-msvc/build/generators/conan_toolchain.cmake",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc",
      "displayName": "Windows MSVC Debug (Conan)",
      "description": "conan install . --output-folder=build/windows-msvc-debug -s build_type=Debug -s compiler.cppstd=17 --build=missing",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-msvc-debug/build/generators/conan_toolchain.cmake",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "conan-base",
      "displayName": "macOS arm64 Release (Conan)",
      "description": "conan install . --output-folder=build/macos-arm64 -s build_type=Release -s compiler.cppstd=17 -s arch=armv8 --build=missing",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/macos-arm64/build/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "conan-base",
      "displayName": "macOS arm64 Debug (Conan)",
      "description": "conan install . --output-folder=build/macos-debug -s build_type=Debug -s compiler.cppstd=17 -s arch=armv8 --build=missing",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/macos-debug/build/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    }
  ]
}
